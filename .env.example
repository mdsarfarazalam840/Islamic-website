# YouTube Data API v3
# Get your API key: https://console.cloud.google.com/apis/credentials
# Enable the YouTube Data API v3 in your Google Cloud project
YOUTUBE_API_KEY=

# Live reader counter (Cloudflare Worker in workers/live)
# Deploy the Worker with `npm run live:deploy`, then paste its URL here.
# Without this the footer badge, per-surah counts, and /live page render nothing.
NEXT_PUBLIC_LIVE_URL=

# Optional: set to "off" to publish only the page path (no surah/audio detail).
# Keeps total + per-page counts and the visit counter.
# NEXT_PUBLIC_LIVE_DETAIL=off
