!.yarn/versions

# rust / tauri
target/

# capacitor
apps/mobile/www/
apps/mobile/android/
apps/mobile/ios/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated pagefind search index (43k files; rebuilt via npm run build:pagefind, hosted on GitHub Pages)
/public/pagefind/

# misc
.DS_Store
*.pem

# raw hadeethenc.com responses cached by npm run fetch:hadith-hindi (~5k files;
# lets re-runs and match-threshold tuning skip the ~20 min network pass)
/.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# cloudflare pages local dev secrets (wrangler pages dev reads this)
.dev.vars

# vercel
.vercel

