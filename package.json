{
  "name": "quran-website",
  "version": "0.2.7",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "dev:pages": "npm run build:static && wrangler pages dev out",
    "build": "next build",
    "build:static": "npm run build:hadith-index && npm run build:hadith-duas && npm run build:pagefind && next build",
    "start": "next start",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint",
    "fetch:quran": "tsx scripts/fetch-quran-data.ts",
    "fetch:hadith": "tsx scripts/fetch-hadith-data.ts && npm run build:hadith-index",
    "fetch:hadith-hindi": "tsx scripts/fetch-hadith-hindi-tafseer.ts",
    "fetch:tafsir-hindi": "tsx scripts/fetch-tafsir-hindi.ts",
    "ai:hindi": "tsx scripts/ai-hindi-pass.ts",
    "scan:devanagari": "tsx scripts/scan-devanagari.ts",
    "fix:devanagari": "tsx scripts/fix-devanagari.ts",
    "add:surah-hindi": "tsx scripts/add-surah-hindi.ts",
    "hadith:hindi": "tsx scripts/apply-hadith-hindi.ts",
    "translit:hadith": "tsx scripts/translit-hadith.ts",
    "fetch:reciters": "tsx scripts/fetch-reciters.ts",
    "fetch:youtube": "tsx scripts/fetch-youtube-data.ts",
    "build:pagefind": "node --import tsx scripts/build-pagefind-index.mjs",
    "build:hadith-index": "node scripts/build-hadith-number-index.mjs",
    "build:hadith-duas": "node scripts/build-hadith-duas.mjs",
    "validate:knowledge": "node scripts/validate-knowledge.mjs",
    "fetch:all": "npm run fetch:quran && npm run fetch:reciters && npm run fetch:hadith && npm run fetch:tafsir-hindi && npm run fetch:youtube && npm run build:pagefind",
    "app:build": "node scripts/build-apps.mjs",
    "app:desktop": "node scripts/build-apps.mjs desktop",
    "app:mobile": "node scripts/build-apps.mjs mobile",
    "app:android": "node scripts/build-apps.mjs android",
    "app:android:apk": "node scripts/build-apps.mjs android --apk",
    "app:android:fast": "node scripts/build-apps.mjs android --skip-web --apk",
    "app:android:release": "node scripts/build-apps.mjs android --release --apk",
    "app:android:icons": "node scripts/generate-android-icons.mjs",
    "test:android": "node scripts/android-smoke.mjs --apk apps/mobile/android/app/build/outputs/apk/debug/app-debug.apk",
    "app:dev:desktop": "npm run build:static && npx tauri dev",
    "app:sync:mobile": "node scripts/build-apps.mjs mobile --skip-web"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "adhan": "^4.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.24.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@>=3": "^5.0.12",
    "fast-uri": "^4.2.3",
    "hono": "^4.13.5",
    "ip-address": "^10.5.0",
    "js-yaml@4": "^4.3.2",
    "nanoid@3": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "undici": "^7.29.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.1",
    "systeminformation": "^5.33.19"
  }
}
