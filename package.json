{
  "name": "quran-website",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "dev:pages": "npm run build:static && wrangler pages dev out",
    "build": "next build",
    "build:static": "npm run build:pagefind && next build",
    "start": "next start",
    "lint": "eslint",
    "fetch:quran": "tsx scripts/fetch-quran-data.ts",
    "fetch:hadith": "tsx scripts/fetch-hadith-data.ts",
    "fetch:youtube": "tsx scripts/fetch-youtube-data.ts",
    "build:pagefind": "node scripts/build-pagefind-index.mjs",
    "fetch:all": "npm run fetch:quran && npm run fetch:hadith && npm run fetch:youtube && npm run build:pagefind",
    "app:build": "node scripts/build-apps.mjs",
    "app:desktop": "node scripts/build-apps.mjs desktop",
    "app:mobile": "node scripts/build-apps.mjs mobile",
    "app:dev:desktop": "npm run build:static && npx tauri dev",
    "app:sync:mobile": "npm run build:static && node scripts/build-apps.mjs mobile"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "adhan": "^4.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  }
}
