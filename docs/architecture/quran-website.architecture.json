    "views": [
      {
        "id": "build-pipeline",
        "label": "Build-time ingestion",
        "focus": [
          "contentApis",
          "youtube",
          "fetchScripts",
          "pagefindIndexer",
          "nextBuild"
        ],
        "note": "Every content source is pulled during CI; the deployed site never calls these APIs."
      },
      {
        "id": "deploy-and-serve",
        "label": "Deploy and serve",
        "focus": [
          "nextBuild",
          "pages",
          "staticData",
          "pagefindIndex",
          "browser"
        ],
        "note": "One Pages artifact carries the exported HTML, the JSON corpus, and the search index."
      },
      {
        "id": "search-path",
        "label": "Client-side search",
        "focus": [
          "pagefindIndexer",
          "pagefindIndex",
          "browser"
        ],
        "note": "Search runs in the browser against a same-origin Pagefind bundle."
      },
      {
        "id": "live-layer",
        "label": "Live visitor layer",
        "focus": [
          "browser",
          "supabase"
        ],
        "note": "The only runtime network dependency the deployed site has, and it is optional."
      },
      {
        "id": "app-shells",
        "label": "Desktop and mobile shells",
        "focus": [
          "nextBuild",
          "shells"
        ],
        "note": "Tauri and Capacitor package the same export instead of loading the hosted site."
      }
    ]
