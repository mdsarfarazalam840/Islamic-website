  "cards": [
    {
      "dot": "cyan",
      "title": "Build-time ingestion",
      "items": [
        "Quran, hadith, and YouTube data are fetched in CI only",
        "A twice-daily cron re-scrapes latest uploads, then redeploys",
        "A failed channel fetch falls back to mock data"
      ]
    },
    {
      "dot": "emerald",
      "title": "One-origin delivery",
      "items": [
        "Export, JSON corpus, and ~43k-file index ship as one artifact",
        "Build-only *-all.json is pruned to stay under the 1 GB cap",
        "out/.nojekyll keeps Jekyll from dropping _next/"
      ]
    },
    {
      "dot": "violet",
      "title": "Runtime and release",
      "items": [
        "The client fetches per-surah and per-book JSON only",
        "Saved items and reading progress stay in localStorage",
        "Only v* tags deploy; rollback ships a known-good tag"
      ]
    }
  ]
